# ============================================================
# O Que Procura? - Configurações de Ambiente (.env)
# ============================================================

SECRET_KEY=tuumweb-production-secret-key-2026

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# Envio de E-mails (Código de Verificação)
# ------------------------------------------------------------
# OPÇÃO 1: RESEND (Recomendado para PythonAnywhere - funciona via HTTPS na porta 443)
# Obtenha sua chave gratuita em: https://resend.com
RESEND_API_KEY=
RESEND_FROM=O Que Procura? <onboarding@resend.dev>

# OPÇÃO 2: SENDGRID (Alternativa via HTTPS porta 443)
# SENDGRID_API_KEY=
# SENDGRID_FROM=contato@tuumweb.com

# OPÇÃO 3: SMTP Padrão (Gmail ou Servidor Próprio)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASSWORD=sua-senha-de-app-google
